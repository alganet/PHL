--TEST--
Dom\HTMLDocument decodes and re-encodes the twenty-seven other single-byte encodings
--EXTENSIONS--
dom
--FILE--
<?php
// The twenty-seven other single-byte encodings of a Dom\HTMLDocument: every
// high byte decoded under each name, and every code point that came out
// encoded back by saveHtml(). Every row is php 8.5's answer; windows-1252,
// x-user-defined and the UTF-16s are tested beside this one.
set_error_handler(function ($no, $msg) { echo "  ! $msg\n"; return true; });
$doc = fn($src, $ov = null) => Dom\HTMLDocument::createFromString($src, LIBXML_NOERROR, $ov);
$names = ['IBM866','ISO-8859-2','ISO-8859-3','ISO-8859-4','ISO-8859-5','ISO-8859-6','ISO-8859-7',
  'ISO-8859-8','ISO-8859-8-I','ISO-8859-10','ISO-8859-13','ISO-8859-14','ISO-8859-15','ISO-8859-16',
  'KOI8-R','KOI8-U','macintosh','windows-874','windows-1250','windows-1251','windows-1253',
  'windows-1254','windows-1255','windows-1256','windows-1257','windows-1258','x-mac-cyrillic'];
foreach ($names as $n) {
	$t = []; $chars = [];
	for ($b = 0x80; $b < 0x100; $b++) {
		$d = $doc("<p>" . chr($b) . "</p>", $n);
		$c = $d->body->textContent;
		$t[] = bin2hex($c);
		if ($c !== "\u{FFFD}") $chars[$c] = 1;
	}
	echo "$n decode {$d->charset} ", implode(' ', $t), "\n";
	// every code point the table decodes, one outside it, U+FFFD and the C1 band
	$d = $doc("<p></p>", $n);
	$d->body->firstChild->textContent = implode('', array_keys($chars)) . "\u{4E2D}\u{FFFD}";
	$c1 = ''; for ($cp = 0x80; $cp < 0xA0; $cp++) $c1 .= mb_chr($cp, 'UTF-8');
	$d->body->appendChild($d->createElement('i'))->textContent = $c1;
	echo "$n encode ", bin2hex($d->saveHtml($d->body)), "\n";
}
// saveXml() re-encodes through libxml's own converter, whose set differs per
// platform (Windows' has no KOI8-R), so it is not measured here
$d = Dom\HTMLDocument::createEmpty('koi8-u'); $d->append($d->createElement('p'));
$d->documentElement->textContent = "\u{0491}\u{4E2D}";
echo "createEmpty koi8-u ", $d->charset, ' ', bin2hex($d->saveHtml()), "\n";
$d = $doc("<meta charset=cp866><p>\x80</p>");
echo "meta cp866 ", $d->charset, ' ', bin2hex($d->body->textContent), ' ', bin2hex($d->saveHtml($d->body)), "\n";
--EXPECT--
