--TEST--
quoted_printable_encode breaks a line at 75 characters
--FILE--
<?php
foreach ([74, 75, 76, 80] as $qpEncWidth) {
    printf("%d => %s\n", $qpEncWidth, bin2hex(quoted_printable_encode(str_repeat('a', $qpEncWidth))));
}
echo bin2hex(quoted_printable_encode(str_repeat("\xc3\xa9", 13))), "\n";
?>
