--TEST--
strtotime/DateTime parse DD-MM-YYYY, slash and dot numeric dates with php field-order rules
--FILE--
<?php
function numericDateCases(): array {
    date_default_timezone_set("UTC");
    $inputs = [
        "15-01-2020", "01-02-2020", "31-12-1999", "15-01-2020 14:30:00",
        "01/15/2020", "12/31/2020", "02/29/2020", "1/5/2020", "01/15/2020 08:00:00",
        "2020/01/15", "2020/1/5", "2020/12/31",
        "13-01-2020", "15-13-2020", "00-01-2020", "32-01-2020",
        "15.01.2020", "2020.01.15", "15-01-20", "31-12-99", "01-02-03",
        "99-01-15", "20-01-15", "0/1/2020", "13/01/2020", "02/30/2020",
        "2020/06/15 12:30:00+05:00", "01/15/2020 00:00:00Z",
    ];
    $out = [];
    foreach ($inputs as $in) { $out[] = $in . " => " . var_export(strtotime($in, 1600000000), true); }
    return $out;
}
echo implode("\n", numericDateCases()), "\n";
--EXPECT--
15-01-2020 => 1579046400
01-02-2020 => 1580515200
31-12-1999 => 946598400
15-01-2020 14:30:00 => 1579098600
01/15/2020 => 1579046400
12/31/2020 => 1609372800
02/29/2020 => 1582934400
1/5/2020 => 1578182400
01/15/2020 08:00:00 => 1579075200
2020/01/15 => 1579046400
2020/1/5 => 1578182400
2020/12/31 => 1609372800
13-01-2020 => 1578873600
15-13-2020 => false
00-01-2020 => 1577750400
32-01-2020 => false
15.01.2020 => 1579046400
2020.01.15 => false
15-01-20 => 1421712000
31-12-99 => false
01-02-03 => 981158400
99-01-15 => 916358400
20-01-15 => 1579046400
0/1/2020 => 1575158400
13/01/2020 => false
02/30/2020 => 1583020800
2020/06/15 12:30:00+05:00 => 1592206200
01/15/2020 00:00:00Z => 1579046400
--CLEAN--
<?php
