--TEST--
intval()/(int) saturate an out-of-range numeric string to PHP_INT_MAX/MIN
--FILE--
<?php
/* A numeric string beyond the signed 64-bit range converts to PHP_INT_MAX (or
 * PHP_INT_MIN when negative), not a value with a dropped digit. In-range values,
 * whitespace, a leading-zero decimal and a non-numeric prefix are unchanged. */
foreach ([
    "99999999999999999999", "-99999999999999999999",
    "9223372036854775807", "9223372036854775808",
    "-9223372036854775808", "-9223372036854775809",
    "10000000000000000000", "-10000000000000000000",
    "123", "  42  ", "007",
] as $s) {
    echo $s, " | ", intval($s), " | ", (int)$s, "\n";
}
?>
--EXPECT--
99999999999999999999 | 9223372036854775807 | 9223372036854775807
-99999999999999999999 | -9223372036854775808 | -9223372036854775808
9223372036854775807 | 9223372036854775807 | 9223372036854775807
9223372036854775808 | 9223372036854775807 | 9223372036854775807
-9223372036854775808 | -9223372036854775808 | -9223372036854775808
-9223372036854775809 | -9223372036854775808 | -9223372036854775808
10000000000000000000 | 9223372036854775807 | 9223372036854775807
-10000000000000000000 | -9223372036854775808 | -9223372036854775808
123 | 123 | 123
  42   | 42 | 42
007 | 7 | 7
