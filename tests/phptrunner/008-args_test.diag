--TEST--
--ARGS-- appends to the child's argv (external mode only; skips in-process)
--ARGS--
alpha beta
--FILE--
<?php
echo "argc=", $argc, "\n";
echo "1=", $argv[1], "\n";
echo "2=", $argv[2], "\n";
?>
--EXPECT--
argc=3
1=alpha
2=beta
