# Respect/Validation -- the only project here whose suite is a full `composer qa`:
# seven steps, two runners, a linter, a static analyser and two console commands.
# Pinned to a commit rather than a tag: the tree tracks `main`.
REPO="https://github.com/Respect/Validation.git"
REF="b885ab8"
# phpcs sniffs 711 files and is by far the most expensive step here: ~3s under php, ~90s
# under phl. It used to be ~14 MINUTES, and the reason recorded here was wrong -- it was
# not "real work" in phpdoc-parser's MARK alternation, it was a leaked `foreach` step
# making OP_FOREACH_INIT quadratic (fixed 26 Aug 2026; see DONE.md). The budget stays: it
# is per STEP and both engines get it, so a timeout is a comparable answer rather than a
# hang, and this is the step an engine performance regression would show up in first.
STEP_TIMEOUT=1800
