# The unit suite is the assertion, constraint, comparator, mock-object and metadata code
# that every other project's verdict passes through.
#
# The end-to-end suite is 805 .phpt cases that each re-run PHPUnit as a CHILD of the
# engine under test. It is the only place in this directory where the engine's own
# PHP_BINARY, $_SERVER, exit status and diagnostics-stream text are what is being
# asserted on, and it is the most expensive step here after composer's: ~46s under php
# and ~12 minutes under phl.
unit	$PHL_VENDOR_ENGINE phpunit --testsuite unit --no-coverage
end-to-end	$PHL_VENDOR_ENGINE phpunit --testsuite end-to-end --no-coverage
