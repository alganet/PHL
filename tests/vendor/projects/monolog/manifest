# Seldaek/monolog -- picked for SHAPE: two dozen handlers, each pulling a different
# vendor package in, which is where a §10 policy row shows what it costs.
REPO="https://github.com/Seldaek/monolog.git"
REF="3.9.0"
# ext-mongodb is a dev requirement of one handler's test double, and the php oracle on
# this box does not have it either -- ignoring it is parity, not an escape. Everything
# behind it SKIPS identically under both engines.
COMPOSER_FLAGS="--ignore-platform-req=ext-mongodb"
# monolog's composer.json sets `config.lock: false`, so composer refuses to write a lock and
# would re-resolve 76 packages from packagist on every run -- a measurement of whatever
# packagist held that morning. This turns locking back on in the CHECKOUT (never in source,
# and reset before every run) so the committed composer.lock beside this file is what
# installs. It is the only reason a PRE_INSTALL is allowed.
PRE_INSTALL='composer_run config lock true'
